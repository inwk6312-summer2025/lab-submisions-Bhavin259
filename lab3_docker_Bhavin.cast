[5103.122776, "o", "\u001b(B\u001b[0;1m\u001b[31m# import Jinja2 library and PyYAML\r\u001b[3d"]
[5103.123182, "o", "\u001b[36mfrom\u001b[39m\u001b(B\u001b[m jinja2 \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Environment, FileSystemLoader\r\u001b[4d"]
[5103.123567, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m yaml"]
[5103.123937, "o", "\u001b[?12l\u001b[?25h"]
[5114.705992, "o", "\u001b[?25l"]
[5114.753999, "o", "# Declare template environment\r\u001b[5d"]
[5114.75482, "o", "ENV = Environment(loader=FileSystemLoader(\u001b(B\u001b[0;1m\u001b[32m'.'\u001b[39m\u001b(B\u001b[m))\r\u001b[6d"]
[5114.755243, "o", "\u001b(B\u001b[0;1m\u001b[36mdef\u001b[34m get_interface_speed\u001b[39m\u001b(B\u001b[m(interface_name):"]
[5114.755634, "o", "\u001b[?12l\u001b[?25h"]
[5125.354799, "o", "\u001b[?25l\r\u001b[7d\u001b[?12l\u001b[?25h"]
[5126.353782, "o", "\u001b[?25l\u001b[8G\u001b[42m\u001b[1K \u001b[49m\u001b(B\u001b[m\u001b[?12l\u001b[?25h"]
[5128.160034, "o", "\u001b[?25l"]
[5128.207456, "o", "\b"]
[5128.208222, "o", "\u001b[1K "]
[5128.208646, "o", "\u001b(B\u001b[0;1m\u001b[32m\"\"\" get_interface_speed returns the default Mbps value for a given\r\u001b[8d"]
[5128.209042, "o", "network interface by looking for certain keywords in the name\r\u001b[9d"]
[5128.209411, "o", "\"\"\""]
[5128.209816, "o", "\u001b[39m\u001b(B\u001b[m"]
[5128.210223, "o", "\u001b[?12l\u001b[?25h"]
[5143.996697, "o", "\u001b[?25l"]
[5144.052768, "o", "\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[32m'gigabit'\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m interface_name.lower():\r\u001b[10d"]
[5144.053478, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m 1000\r\u001b[11d"]
[5144.053911, "o", "\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[32m'fast'\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m interface_name.lower():\r\u001b[12d"]
[5144.054306, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m 100\r\u001b[13d"]
[5144.054693, "o", "\u001b(B\u001b[0;1m\u001b[31m# Filters are added to the ENV object after declaration. Note that we're\r\u001b[14d"]
[5144.055125, "o", "# actually passing in our \"get_interface_speed\" function and not running\r\u001b[15d"]
[5144.055533, "o", "# it--the template engine will execute this function when we call\r\u001b[16d"]
[5144.055907, "o", "# template.render()\r\u001b[17d"]
[5144.056324, "o", "\u001b[39m\u001b(B\u001b[mENV.filters[\u001b(B\u001b[0;1m\u001b[32m'get_interface_speed'\u001b[39m\u001b(B\u001b[m] = get_interface_speed\r\u001b[18d"]
[5144.056715, "o", "template = ENV.get_template(\u001b(B\u001b[0;1m\u001b[32m\"template-task8.j2\"\u001b[39m\u001b(B\u001b[m)\r\u001b[19d"]
[5144.057129, "o", "\u001b(B\u001b[0;1m\u001b[31m# We load our YAML file and pass it in to the template when rendering it.\r\u001b[20d"]
[5144.05751, "o", "\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m\"data-task7.yml\"\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m f:\r\u001b[21d"]
[5144.057917, "o", "interfaces = yaml.load(f, Loader=yaml.SafeLoader)\r\u001b[22d"]
[5144.058328, "o", "print(template.render(interface_list=interfaces))"]
