[3586.677257, "o", "\r\n"]
[3586.677833, "o", "import logging"]
[3586.678236, "o", "\r\n"]
[3586.678642, "o", "import requests"]
[3586.679158, "o", "\r\n"]
[3586.679597, "o", "from requests.auth import HTTPBasicAuth"]
[3586.68001, "o", "\r\n"]
