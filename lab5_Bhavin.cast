[3586.681003, "o", "\r\n"]
[3586.681361, "o", "\r\n"]
[3586.681733, "o", "logging.basicConfig(level=logging.INFO, format='%(name)s - %(levelname)s - %(message)s')"]
[3586.682084, "o", "\r\n"]
[3586.682462, "o", "\r\n"]
[3586.682848, "o", "HOST = '192.168.1.101'"]
[3586.683225, "o", "\r\n"]
[3586.683625, "o", "USER = 'student'"]
[3586.684002, "o", "\r\n"]
[3586.684422, "o", "PASS = 'Meilab123'"]
[3586.684846, "o", "\r\n"]
[3586.685228, "o", "BASE_URL = f'http://{HOST}/restconf/api/running/'"]
[3586.685655, "o", "\r\n"]
[3586.686064, "o", "\r\n"]
[3586.686616, "o", "def set_interfaces(append_url, interface_name):"]
[3586.687007, "o", "\r\n"]
[3586.68742, "o", "    url = BASE_URL + append_url + interface_name"]
[3586.687795, "o", "\r\n"]
[3586.688043, "o", "    auth = HTTPBasicAuth(USER, PASS)"]
[3586.688231, "o", "\r\n"]
[3586.688414, "o", "    headers = {"]
[3586.688589, "o", "\r\n"]
[3586.688724, "o", "        'Accept': 'application/vnd.yang.data+json',"]
[3586.68886, "o", "\r\n"]
[3586.688993, "o", "        'Content-Type': 'application/vnd.yang.data+json'"]
[3586.689227, "o", "\r\n"]
[3586.68937, "o", "    }"]
[3586.689498, "o", "\r\n"]
[3586.689633, "o", "\r\n"]
[3586.689766, "o", "    data = {"]
[3586.689902, "o", "\r\n"]
[3586.69003, "o", "        \"ietf-interfaces:interface\": {"]
[3586.691527, "o", "\r\n            \"name\": interface_name,\r\n            \"description\": \"Changed through Restconf\",\r\n            \"type\": \"iana-if-type:ethernetCsmacd\",\r\n            \"enabled\": True,\r\n            \"ietf-ip:ipv4\": {"]
[3586.692324, "o", "\r\n                \"address\": [\r\n                    {\r\n                        \"ip\": \"10.0.10.3\",\r\n                        \"netmask\": \"255.255.255.0\"\r\n                    }\r\n                ]\r\n            },\r\n            \"ietf-ip:ipv6\": {}\r\n        }\r\n    }\r\n\r\n    response = requests.put(url, auth=auth, headers=headers, data=json.dumps(data))\r\n    if response.status_code == 204:\r\n        logging.info(f\"Request was successful on {HOST}, Code: {response.status_code}\")\r\n        return \"Success!\"\r\n    else:\r\n        logging.error(f\"Error encountered during request on {HOST}, Code: {response.status_code}, Message: {response.text}\")\r\n        return response.text\r\n\r\n    print(set_interfaces(\"interfaces/interface/\", \"GigabitEthernet3\"))\r\n(venv) \u001b]0;student@6312vm-csr30: ~/Desktop/restconf-lab/tasks\u0007\u001b[01;32mstudent@6312vm-csr30\u001b[00m:\u001b[01;34m~/Desktop/restconf-lab/tasks\u001b[00m$ "]
