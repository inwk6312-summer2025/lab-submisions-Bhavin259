[6255.715086, "o", "\u001b(B\u001b[m"]
[6255.715607, "o", "\r\u001b[56d"]
[6255.716031, "o", "\u001b(B\u001b[0;7m^G\u001b(B\u001b[m Get Help   \u001b(B\u001b[0;7m^O\u001b(B\u001b[m Write Out  \u001b(B\u001b[0;7m^W\u001b(B\u001b[m Where Is   \u001b(B\u001b[0;7m^K\u001b(B\u001b[m Cut Text   \u001b(B\u001b[0;7m^J\u001b(B\u001b[m Justify    \u001b(B\u001b[0;7m^C\u001b(B\u001b[m Cur Pos    \u001b(B\u001b[0;7mM-U\u001b(B\u001b[m Undo\r\u001b[57d"]
[6255.716429, "o", "\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Exit\u001b[15G"]
[6255.716829, "o", "\u001b(B\u001b[0;7m^R\u001b(B\u001b[m Read File  \u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Replace    \u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste Text \u001b(B\u001b[0;7m^T\u001b(B\u001b[m To Spell   \u001b(B\u001b[0;7m^_\u001b(B\u001b[m Go To Line \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\r\u001b[55d"]
[6255.718805, "o", "\u001b[2d"]
[6255.719233, "o", "\u001b(B\u001b[0;1m\u001b[31m# import Jinja2 library and PyYAML\r\u001b[3d"]
[6255.71965, "o", "\u001b[36mfrom\u001b[39m\u001b(B\u001b[m jinja2 \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Environment, FileSystemLoader\r\u001b[4d"]
[6255.720058, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m yaml# Declare template environment\r\u001b[5d"]
[6255.720503, "o", "ENV = Environment(loader=FileSystemLoader(\u001b(B\u001b[0;1m\u001b[32m'.'\u001b[39m\u001b(B\u001b[m))\r\u001b[6d"]
[6255.720916, "o", "\u001b(B\u001b[0;1m\u001b[36mdef\u001b[34m get_interface_speed\u001b[39m\u001b(B\u001b[m(interface_name):\u001b[7;9H"]
[6255.721332, "o", "\u001b(B\u001b[0;1m\u001b[32m\"\"\" get_interface_speed returns the default Mbps value for a given\r\u001b[8d"]
[6255.72178, "o", "network interface by looking for certain keywords in the name\r\u001b[9d"]
[6255.722173, "o", "\"\"\"\r\u001b[10d"]
[6255.722619, "o", "\u001b[36mif\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[32m'gigabit'\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m interface_name.lower():\r\u001b[11d"]
[6255.723026, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m 1000\r\u001b[12d"]
[6255.723425, "o", "\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[32m'fast'\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m interface_name.lower():\r\u001b[13d"]
[6255.723811, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m 100\r\u001b[14d"]
[6255.724189, "o", "\u001b(B\u001b[0;1m\u001b[31m# Filters are added to the ENV object after declaration. Note that we're\r\u001b[15d"]
[6255.724615, "o", "# actually passing in our \"get_interface_speed\" function and not running\r\u001b[16d"]
[6255.724974, "o", "# it--the template engine will execute this function when we call\r\u001b[17d"]
[6255.725357, "o", "# template.render()\r\u001b[18d"]
[6255.72579, "o", "\u001b[39m\u001b(B\u001b[mENV.filters[\u001b(B\u001b[0;1m\u001b[32m'get_interface_speed'\u001b[39m\u001b(B\u001b[m] = get_interface_speed\r\u001b[19d"]
[6255.726229, "o", "template = ENV.get_template(\u001b(B\u001b[0;1m\u001b[32m\"template-task8.j2\"\u001b[39m\u001b(B\u001b[m)\r\u001b[20d"]
[6255.726635, "o", "\u001b(B\u001b[0;1m\u001b[31m# We load our YAML file and pass it in to the template when rendering it.\r\u001b[21d"]
[6255.727081, "o", "\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m\"data-task7.yml\"\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m f:\r\u001b[22d"]
[6255.727498, "o", "interfaces = yaml.load(f, Loader=yaml.SafeLoader)\r\u001b[23d"]
