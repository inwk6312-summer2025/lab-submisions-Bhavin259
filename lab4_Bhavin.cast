[4768.115184, "o", "\r\u001b[2d"]
[4768.115602, "o", "from netmiko import Netmiko\r\u001b[3d"]
[4768.116019, "o", "devices = [{\"device_type\": \"cisco_ios\",\r\u001b[4d"]
[4768.116425, "o", "\"ip\": \"192.168.1.101\",\r\u001b[5d"]
[4768.116822, "o", "\"username\": \"student\",\r\u001b[6d"]
[4768.117235, "o", "\"password\": \"Meilab123\",\r\u001b[7d"]
[4768.117687, "o", "\"port\": \"22\",}]\r\u001b[8d"]
[4768.118126, "o", "description = 'Description set with Netmiko'\r\u001b[9d"]
[4768.1185, "o", "description_config = [\"interface GigabitEthernet3\",\r\u001b[10d"]
[4768.11896, "o", "f\"description {description}\"]\r\u001b[11d"]
[4768.119375, "o", "for device in devices:\r\u001b[12d"]
[4768.119757, "o", "net_connect = Netmiko(**device)\r\u001b[13d"]
[4768.120204, "o", "output = net_connect.send_config_set(description_config)\r\u001b[14d"]
[4768.120584, "o", "print(output)\r\u001b[15d"]
[4768.12096, "o", "net_connect.disconnect()"]
