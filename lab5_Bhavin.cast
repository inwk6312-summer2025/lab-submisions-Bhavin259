[3690.037795, "o", "]\u001b[35;13H"]
[3690.038056, "o", "},\u001b[36d\b\b"]
[3690.038314, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ietf-ip:ipv6\"\u001b[39m\u001b(B\u001b[m: {}\u001b[37;9H"]
[3690.038568, "o", "}\u001b[38;5H"]
[3690.038829, "o", "}\u001b[40d\b"]
[3690.039088, "o", "response = requests.put(url, auth=auth, headers=headers, data=json.dumps(data))\u001b[41;5H"]
