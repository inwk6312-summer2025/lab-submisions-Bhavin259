[2036.732611, "o", "\u001b[39m\u001b(B\u001b[mBASE_URL = \u001b(B\u001b[0;1m\u001b[32m'http://{0}/restconf/api/running/'\u001b[39m\u001b(B\u001b[m.format(HOST)\r\u001b[14d"]
[2036.733072, "o", "\u001b(B\u001b[0;1m\u001b[36mdef\u001b[34m get_interfaces\u001b[39m\u001b(B\u001b[m(append_url):\u001b[15;9H"]
[2036.733479, "o", "url = BASE_URL + append_url\u001b[16;9H"]
[2036.733917, "o", "auth = HTTPBasicAuth(USER, PASS)\u001b[17;9H"]
[2036.734346, "o", "headers = {\u001b(B\u001b[0;1m\u001b[32m'Accept'\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m'application/vnd.yang.data+json'\u001b[39m\u001b(B\u001b[m}\u001b[19;9H"]
[2036.734804, "o", "logging.info(f\u001b(B\u001b[0;1m\u001b[32m\"URL ==> {url}\"\u001b[39m\u001b(B\u001b[m)\u001b[20;9H"]
[2036.73523, "o", "response = requests.get(url, auth=auth, headers=headers)\u001b[21;9H"]
[2036.735648, "o", "\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m response.status_code == 200:\u001b[22;17H"]
